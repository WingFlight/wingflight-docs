{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "MkDocs Serve",
      "type": "debugpy",
      "request": "launch",
      "module": "mkdocs",
      "args": ["serve"],
      "preLaunchTask": "Install requirements",
      "justMyCode": true,
      "serverReadyAction": {
        "pattern": "Serving on (https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ]
}
